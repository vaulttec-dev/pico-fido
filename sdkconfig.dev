# Debug overlay. Chained ONLY by DEV=1 ./tools/build.sh, on top of sdkconfig.vaulttec.
#
# Never ship a build made with this file. It puts the console back, and
# pico-keys-sdk prints every CTAPHID command code and length through printf().

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
